# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/dbname

# Google OAuth credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# App base URL (e.g. http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# Comma-separated list of admin email addresses
ADMIN_EMAILS=

# Optional comma-separated allowlist of emails that may sign in.
# When set, only these (and ADMIN_EMAILS) may join. Unset = open registration.
ALLOWED_EMAILS=

# Drizzle Kit reads from .env by default
# Copy this file to .env and fill in your values:
#   cp .env.example .env