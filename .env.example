# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/dbname

# Google OAuth credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# App base URL (e.g. http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# Comma-separated list of admin email addresses
ADMIN_EMAILS=

# Vercel Blob (photo storage)
BLOB_READ_WRITE_TOKEN=

# Drizzle Kit reads from .env.local by default (see package.json scripts)
# Copy this file to both .env (for dev) and .env.local (for db:generate/migrate):
#   cp .env.example .env && cp .env.example .env.local